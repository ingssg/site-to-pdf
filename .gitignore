# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/lambda/node_modules
/lambda/function.zip
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# project docs (internal use only)
/docs

# lambda 가이드 문서 (내부 참고용)
/lambda/*-가이드.md
/lambda/*-해결.md
/lambda/*-체크리스트.md
/lambda/수정-완료-요약.md
/lambda/최종-해결-방법.md
/lambda/페이지-관리-전략-분석.md
/lambda/동기식-비동기식-차이.md
/lambda/README-AWS-CLI-INSTALL.md
/lambda/README-CONTAINER.md
/lambda/CMD-재정의-설정-가이드.md
/lambda/CONTAINER-IMAGE-연결-가이드.md
/lambda/Dockerfile-CMD-수정-가이드.md
/lambda/Handler-설정-찾기.md

# fonts (downloaded at build time via postinstall script)
/public/fonts/*.ttf
/public/fonts/*.otf
/public/fonts/*.woff
/public/fonts/*.woff2

# temporary files (PDF/ZIP downloads)
/public/temp/
