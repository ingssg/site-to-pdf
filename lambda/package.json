{
  "name": "site-to-pdf-lambda-worker",
  "version": "1.0.0",
  "description": "AWS Lambda worker for site-to-pdf crawling and PDF generation",
  "main": "index.js",
  "scripts": {
    "deploy": "zip -r function.zip . -x '*.git*' 'node_modules/playwright/*' 'node_modules/playwright-core/*' 'node_modules/.bin/playwright*' '*.zip' && zip -d function.zip 'node_modules/.bin/playwright*' 'node_modules/playwright-core/*' 2>/dev/null || true"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.969.0",
    "@aws-sdk/client-s3": "^3.969.0",
    "@aws-sdk/s3-request-presigner": "^3.969.0",
    "@sparticuz/chromium": "^131.0.1",
    "@supabase/supabase-js": "^2.89.0",
    "jszip": "^3.10.1",
    "openai": "^6.15.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.49.0",
    "sharp": "^0.34.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
